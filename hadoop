### Phase 2: Project Setup & MapReduce Source Code

#### 9. Create project directory

```bash
mkdir -p "$HOME/LoginDurationProject/src"
cd "$HOME/LoginDurationProject"

```

#### 10. Create Java source file

Create the complete Java program containing the Mapper, Reducer, and Driver classes handling two sequential MapReduce jobs (Job 1: calculate durations per user session; Job 2: find the maximum login duration).

```bash
nano src/LoginDuration.java

```

Paste the following complete Java code into `src/LoginDuration.java`:

```java
import java.io.IOException;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.time.Duration;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

import org.apache.hadoop.conf.Configuration;
import org.apache.hadoop.fs.Path;
import org.apache.hadoop.io.LongWritable;
import org.apache.hadoop.io.Text;
import org.apache.hadoop.mapreduce.Job;
import org.apache.hadoop.mapreduce.Mapper;
import org.apache.hadoop.mapreduce.Reducer;
import org.apache.hadoop.mapreduce.lib.input.FileInputFormat;
import org.apache.hadoop.mapreduce.lib.output.FileOutputFormat;

public class LoginDuration {

    private static final DateTimeFormatter FORMAT = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");

    // Mapper Class
    public static class LoginMapper extends Mapper<LongWritable, Text, Text, Text> {
        public void map(LongWritable key, Text value, Context context) throws IOException, InterruptedException {
            String[] fields = value.toString().split("\\s*\\|\\s*");
            if (fields.length < 4) return;
            
            String timestamp = fields[0].trim();
            String user = "";
            String event = "";
            String status = "";

            for (String field : fields) {
                field = field.trim();
                if (field.startsWith("user="))
                    user = field.substring(5);
                if (field.startsWith("event="))
                    event = field.substring(6);
                if (field.startsWith("status="))
                    status = field.substring(7);
            }

            if (!user.isEmpty() && status.equals("SUCCESS") && (event.equals("LOGIN") || event.equals("LOGOUT"))) {
                context.write(new Text(user), new Text(timestamp + "|" + event));
            }
        }
    }

    // Reducer Class for Job 1: Calculate Total/Session Durations per User
    public static class LoginReducer extends Reducer<Text, Text, Text, Text> {
        public void reduce(Text key, Iterable<Text> values, Context context) throws IOException, InterruptedException {
            List<LocalDateTime> logins = new ArrayList<>();
            List<LocalDateTime> logouts = new ArrayList<>();

            for (Text val : values) {
                String[] parts = val.toString().split("\\|");
                LocalDateTime time = LocalDateTime.parse(parts[0], FORMAT);
                if (parts[1].equals("LOGIN")) {
                    logins.add(time);
                } else if (parts[1].equals("LOGOUT")) {
                    logouts.add(time);
                }
            }

            Collections.sort(logins);
            Collections.sort(logouts);

            long totalSeconds = 0;
            int minSize = Math.min(logins.size(), logouts.size());
            for (int i = 0; i < minSize; i++) {
                if (logouts.get(i).isAfter(logins.get(i))) {
                    totalSeconds += Duration.between(logins.get(i), logouts.get(i)).getSeconds();
                }
            }

            context.write(key, new Text(String.valueOf(totalSeconds)));
        }
    }

    // Mapper for Job 2: Pass data to find maximum
    public static class MaxMapper extends Mapper<LongWritable, Text, Text, Text> {
        public void map(LongWritable key, Text value, Context context) throws IOException, InterruptedException {
            String[] parts = value.toString().split("\\s+");
            if (parts.length >= 2) {
                context.write(new Text("MaxDuration"), new Text(parts[0] + "\t" + parts[1]));
            }
        }
    }

    // Reducer for Job 2: Find maximum duration user
    public static class MaxReducer extends Reducer<Text, Text, Text, Text> {
        public void reduce(Text key, Iterable<Text> values, Context context) throws IOException, InterruptedException {
            String maxUser = "";
            long maxSecs = -1;

            for (Text val : values) {
                String[] parts = val.toString().split("\\s+");
                if (parts.length >= 2) {
                    String user = parts[0];
                    long secs = Long.parseLong(parts[1]);
                    if (secs > maxSecs) {
                        maxSecs = secs;
                        maxUser = user;
                    }
                }
            }
            context.write(new Text(maxUser), new Text(maxSecs + " seconds"));
        }
    }

    // Driver Code
    public static void main(String[] args) throws Exception {
        Configuration conf = new Configuration();
        
        // Job 1: Calculate user durations
        Job job1 = Job.getInstance(conf, "Login Duration Calculation");
        job1.setJarByClass(LoginDuration.class);
        job1.setMapperClass(LoginMapper.class);
        job1.setReducerClass(LoginReducer.class);
        job1.setOutputKeyClass(Text.class);
        job1.setOutputValueClass(Text.class);
        FileInputFormat.addInputPath(job1, new Path(args[0]));
        FileOutputFormat.setOutputPath(job1, new Path(args[1]));
        boolean success = job1.waitForCompletion(true);
        if (!success) System.exit(1);

        // Job 2: Find Maximum Duration
        Job job2 = Job.getInstance(conf, "Max Login Duration");
        job2.setJarByClass(LoginDuration.class);
        job2.setMapperClass(MaxMapper.class);
        job2.setReducerClass(MaxReducer.class);
        job2.setOutputKeyClass(Text.class);
        job2.setOutputValueClass(Text.class);
        FileInputFormat.addInputPath(job2, new Path(args[1]));
        FileOutputFormat.setOutputPath(job2, new Path(args[2]));
        System.exit(job2.waitForCompletion(true) ? 0 : 1);
    }
}

```

